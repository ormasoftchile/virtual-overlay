<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="Virtual Overlay"
             Manufacturer="Virtual Overlay"
             Version="1.3.0.0"
             UpgradeCode="F8E3B5A1-7C2D-4E9F-B6A8-3D1C5E7F9A2B"
             Scope="perMachine">

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                      AllowSameVersionUpgrades="yes" />

        <util:CloseApplication xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
                               Id="CloseVO"
                               Target="virtual-overlay.exe"
                               CloseMessage="yes"
                               ElevatedCloseMessage="yes"
                               TerminateProcess="500"
                               RebootPrompt="no" />

        <Media Id="1" Cabinet="VirtualOverlay.cab" EmbedCab="yes" />

        <Icon Id="AppIcon" SourceFile="..\res\icon.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon" />
        <Property Id="ARPNOMODIFY" Value="1" />

        <!-- Per-machine under Program Files: required for the uiAccess EXE
             (teleprompter mirror above the Start menu / Task View). -->
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="VirtualOverlay">
                <Component Id="MainExecutable" Guid="EA0F230B-AD57-44D8-9E3A-F05D8A0AD277" Bitness="always64">
                    <File Id="VirtualOverlayExe" Source="..\build\Release\virtual-overlay.exe" KeyPath="yes">
                        <Shortcut Id="StartMenuShortcut"
                                  Name="Virtual Overlay"
                                  Directory="ProgramMenuFolder"
                                  WorkingDirectory="INSTALLFOLDER"
                                  Icon="AppIcon"
                                  Advertise="yes" />
                    </File>
                </Component>

                <Component Id="VoskRuntime" Guid="*" Bitness="always64">
                    <File Id="VoskDll" Source="..\build\Release\libvosk.dll" KeyPath="yes" />
                </Component>
                <Component Id="VoskGccRuntime" Guid="*" Bitness="always64">
                    <File Id="VoskGccDll" Source="..\build\Release\libgcc_s_seh-1.dll" KeyPath="yes" />
                </Component>
                <Component Id="VoskCppRuntime" Guid="*" Bitness="always64">
                    <File Id="VoskCppDll" Source="..\build\Release\libstdc++-6.dll" KeyPath="yes" />
                </Component>
                <Component Id="VoskThreadRuntime" Guid="*" Bitness="always64">
                    <File Id="VoskThreadDll" Source="..\build\Release\libwinpthread-1.dll" KeyPath="yes" />
                </Component>
                <Component Id="RuntimeNotices" Guid="E0CAB69A-7624-4D26-A12E-843C94CE83B9" Bitness="always64">
                    <File Id="ThirdPartyNotices" Source="..\build\Release\THIRD_PARTY_NOTICES.md" KeyPath="yes" />
                    <File Id="VoskLicense" Source="..\build\Release\LICENSE.vosk.txt" />
                    <File Id="GccLicense" Source="..\build\Release\LICENSE.gcc.txt" />
                    <File Id="GccRuntimeLicense" Source="..\build\Release\LICENSE.gcc-runtime.txt" />
                    <File Id="WinpthreadsLicense" Source="..\build\Release\LICENSE.winpthreads.txt" />
                    <File Id="KaldiLicense" Source="..\build\Release\LICENSE.kaldi.txt" />
                    <File Id="OpenFstLicense" Source="..\build\Release\LICENSE.openfst.txt" />
                    <File Id="OpenBlasLicense" Source="..\build\Release\LICENSE.openblas.txt" />
                    <File Id="GotoBlasLicense" Source="..\build\Release\LICENSE.gotoblas.txt" />
                    <File Id="ClapackLicense" Source="..\build\Release\LICENSE.clapack.txt" />
                    <File Id="F2cLicense" Source="..\build\Release\LICENSE.f2c.txt" />
                    <File Id="MingwRuntimeLicense" Source="..\build\Release\LICENSE.mingw-runtime.txt" />
                    <File Id="VoskSources" Source="..\build\Release\SOURCES.vosk.txt" />
                </Component>

                <!-- Startup registry entry for the installing user (the app's
                     "start with Windows" setting manages the same HKCU value). -->
                <Component Id="AutoStart" Guid="5404BA2C-0AF9-4B52-B45F-755D6DA263E6">
                    <RegistryValue Root="HKCU"
                                   Key="Software\Microsoft\Windows\CurrentVersion\Run"
                                   Name="VirtualOverlay"
                                   Type="string"
                                   Value="&quot;[INSTALLFOLDER]virtual-overlay.exe&quot;"
                                   KeyPath="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder" />

        <CustomAction Id="LaunchApp"
                      Directory="INSTALLFOLDER"
                      ExeCommand="&quot;[INSTALLFOLDER]virtual-overlay.exe&quot;"
                      Execute="immediate"
                      Return="asyncNoWait" />

        <Feature Id="MainFeature" Title="Virtual Overlay" Level="1">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="VoskRuntime" />
            <ComponentRef Id="VoskGccRuntime" />
            <ComponentRef Id="VoskCppRuntime" />
            <ComponentRef Id="VoskThreadRuntime" />
            <ComponentRef Id="RuntimeNotices" />
            <ComponentRef Id="AutoStart" />
        </Feature>

        <!-- Launch from the (non-elevated) UI sequence so the app does not run
             with the installer's elevated token. -->
        <InstallUISequence>
            <Custom Action="LaunchApp" After="ExecuteAction" Condition="NOT Installed" />
        </InstallUISequence>

    </Package>
</Wix>
